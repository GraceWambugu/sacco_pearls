# Copy this file to backend/.env and fill in YOUR values. NEVER commit .env
# If your postgres password has special characters (@ # / :) URL-encode them, e.g. @ -> %40
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/sacco_db
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=60

# Required for mobile password reset emails. Use an app password, not your mailbox password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
